      "5": { "name": "Image 3" },
      "6": { "name": "Image 4" },
      "7": { "name": "Image 5" },
      "8": { "name": "Image 6" },
      "9": { "name": "Image 7" },
      "10": { "name": "Image 8" },
      "11": { "name": "Image 9" },
      "12": { "name": "Image 10" }
    }
